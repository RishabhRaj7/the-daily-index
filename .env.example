DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Gemini — article summaries, edition brief, Editor's Picks blurbs, Editor's Desk note.
# Everything degrades gracefully to raw RSS snippets / a deterministic desk note without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_SUMMARIZE=true

# Gemini for the F1 live centre (team radio transcripts): a key from a second
# Google project, so the race and the morning paper never share a quota.
# Without it, radio shares GEMINI_API_KEY (and keeps to a smaller budget).
GEMINI_F1_API_KEY=

# Reddit — free "script" app from https://www.reddit.com/prefs/apps
# Set REDDIT_ENABLED=true to fetch Reddit content. Disabled by default.
REDDIT_ENABLED=false
# Application-only OAuth; no user login needed. Without these the paper falls
# back to Reddit's public JSON (unreliable from cloud IPs) and says so honestly.
#
# The SAME script app also powers Login-with-Reddit (your subscriptions in
# the Grapevine). For that, add these redirect URIs in the app's settings:
#   http://localhost:3000/api/reddit/callback   (local dev)
#   https://<your-domain>/api/reddit/callback   (production)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:the-daily-index:v1.1 (by /u/your_username)

# Server-built editions + archive — Upstash Redis (free tier).
# Vercel dashboard → your project → Storage → Create → Upstash for Redis.
# The integration injects these automatically (either pair works):
#   KV_REST_API_URL / KV_REST_API_TOKEN
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Without them, editions are built inline on each request and nothing is
# archived (local dev keeps them in memory until the server restarts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# One database can serve Production and Preview: keys are prefixed with the
# Vercel environment (production: / preview: / development:), so preview
# testing never touches the live archive. Override only if you need to:
# STORE_NAMESPACE=production

# Protects /api/cron/* — Vercel Cron sends it automatically once it is set.
# Any long random string (e.g. `openssl rand -hex 32`, or a password manager).
CRON_SECRET=

# Optional tuning (defaults shown).
# EDITION_STALE_HOURS=6        # rebuild in the background when older than this
# EDITION_BUILDS_PER_DAY=60    # visitor-triggered builds per day, all visitors
# EDITION_BUILDS_PER_IP=8      # visitor-triggered builds per day, per IP
# NEXT_PUBLIC_EDITION_TIME_ZONE=Asia/Kolkata

# Mapbox public token (pk.…) for the F1 map's 3D city view; without it the map has only the basic view
NEXT_PUBLIC_MAPBOX_TOKEN=

# X feeds (Grapevine, IPO chatter, Clutch's transfer window) through our own
# RSSHub on a free Hugging Face Space — setup in deploy/rsshub/README.md.
# Without these the X parts say so and Reddit still prints.
RSSHUB_URL=
RSSHUB_ACCESS_KEY=

# Reddit is read through its public RSS (no API app needed). Set to false to switch it off.
# REDDIT_RSS=true

# F1 car data (the speedometer) — F1 sends it only to a signed-in F1 TV
# Access/Pro account. Log in at f1tv.formula1.com, open the browser's dev
# tools → Application → Cookies, and copy `subscriptionToken` out of the
# `login-session` cookie (it is URL-encoded JSON). It lasts a few days; when
# the speedometer says "No car data" again, paste a fresh one. Optional: the
# timing never depends on it. Showing F1 TV data on a public site is against
# F1 TV's terms, so the account could be suspended.
F1TV_TOKEN=
